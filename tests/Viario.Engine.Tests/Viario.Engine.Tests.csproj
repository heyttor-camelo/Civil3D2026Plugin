<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes da geometria pura do Viario (motor da rede + contorno da hachura), sem AutoCAD.
    Os arquivos puros de Modules/Viario entram por link, para o plugin continuar numa DLL so.
    Rodar: dotnet test tests/Viario.Engine.Tests
    Refazer o calculo de um desenho do Heyvid: VIARIO_DUMP=<caminho do viario-*.json> dotnet test tests/Viario.Engine.Tests
    (o JSON e gravado pelo C3DVIARIOHACHURA > Gerar em %LOCALAPPDATA%\Civil3D2026Plugin\diag e em G:\Meu Drive\Civil3D2026Plugin\diag).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Civil3D2026Plugin.Modules.Viario.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8604;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Civil3D2026Plugin\Modules\Viario\ViarioGeometry.cs" Link="Viario\ViarioGeometry.cs" />
    <Compile Include="..\..\src\Civil3D2026Plugin\Modules\Viario\ViarioEngine.cs" Link="Viario\ViarioEngine.cs" />
    <Compile Include="..\..\src\Civil3D2026Plugin\Modules\Viario\ViarioElements.cs" Link="Viario\ViarioElements.cs" />
    <Compile Include="..\..\src\Civil3D2026Plugin\Modules\Viario\ViarioHatch.cs" Link="Viario\ViarioHatch.cs" />
    <Compile Include="..\..\src\Civil3D2026Plugin\Modules\Viario\ViarioDump.cs" Link="Viario\ViarioDump.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
