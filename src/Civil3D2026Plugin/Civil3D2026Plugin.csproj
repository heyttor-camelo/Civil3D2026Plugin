<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Alvo do AutoCAD/Civil 3D: 2026 (.NET 8) ou 2027 (.NET 10).
    - dotnet build -p:Acad=2027     (ou configuracao Debug2027 / Release2027 no VS)
    - sem nada: 2026, como sempre.
    O 2027 nao e compativel em binario com o 2026 (blog.autodesk.io, "AutoCAD 2027 SDK"):
    precisa recompilar contra as DLLs de 2027, e projetos .NET para 2027 exigem VS 2026.
  -->
  <PropertyGroup>
    <Acad Condition="'$(Acad)' == '' And $([System.String]::Copy('$(Configuration)').EndsWith('2027'))">2027</Acad>
    <Acad Condition="'$(Acad)' == ''">2026</Acad>
    <Configurations>Debug;Release;Debug2027;Release2027</Configurations>
    <!-- Debug2027/Release2027 herdam de Debug/Release -->
    <DebugSymbols Condition="'$(Configuration)' == 'Debug2027'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Debug2027'">portable</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Debug2027'">false</Optimize>
    <DefineConstants Condition="'$(Configuration)' == 'Debug2027'">$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize Condition="'$(Configuration)' == 'Release2027'">true</Optimize>
    <DefineConstants Condition="'$(Configuration)' == 'Release2027'">$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Acad)' == '2026'">
    <!--
      AcadDir pode vir de fora (dotnet build -p:AcadDir=...), por exemplo apontando para uma copia
      .NET 8 das DLLs da Autodesk. Sem isso, usa a instalacao local.
      Runtime: as atualizacoes do Civil 3D 2026 a partir do build 25.1.179 rodam em .NET 10 e suas
      DLLs exigem System.Runtime 10 (CS1705 ao compilar para net8). O alvo segue o
      acdbmgd.runtimeconfig.json da pasta de referencia: net10.0 ou net8.0. Uma DLL net8
      (compilada contra DLLs .NET 8) carrega nas duas instalacoes; uma net10 so na .NET 10.
    -->
    <AcadDir Condition="'$(AcadDir)' == ''">$(ProgramFiles)\Autodesk\AutoCAD 2026</AcadDir>
    <AcadRuntimeConfig>$(AcadDir)\acdbmgd.runtimeconfig.json</AcadRuntimeConfig>
    <AcadTfm Condition="Exists('$(AcadRuntimeConfig)') And $([System.IO.File]::ReadAllText('$(AcadRuntimeConfig)').Contains('net10.0'))">net10.0-windows</AcadTfm>
    <AcadTfm Condition="'$(AcadTfm)' == ''">net8.0-windows</AcadTfm>
    <TargetFramework>$(AcadTfm)</TargetFramework>
    <!-- 2026 continua saindo em NETLOAD\ (mesmo caminho de sempre). -->
    <OutputPath>$(MSBuildProjectDirectory)\..\..\NETLOAD\</OutputPath>
    <DefineConstants>$(DefineConstants);ACAD2026</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Acad)' == '2027'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <AcadDir>$(ProgramFiles)\Autodesk\AutoCAD 2027</AcadDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\NETLOAD\2027\</OutputPath>
    <DefineConstants>$(DefineConstants);ACAD2027</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Civil3D2026Plugin</AssemblyName>
    <RootNamespace>Civil3D2026Plugin</RootNamespace>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>

    <!--
      Saida fixa para facilitar NETLOAD.
      Depois de qualquer Build/Rebuild, a DLL atual fica em:
      <raiz-do-projeto>\NETLOAD\Civil3D2026Plugin.dll        (2026)
      <raiz-do-projeto>\NETLOAD\2027\Civil3D2026Plugin.dll   (2027)
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Referencias do AutoCAD / Civil 3D, na pasta do alvo ($(AcadDir)).
    Private=False evita copiar DLLs Autodesk para NETLOAD; o Civil 3D ja fornece
    essas dependencias em runtime.
  -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgdbrep">
      <HintPath>$(AcadDir)\acdbmgdbrep.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecPropDataMgd">
      <HintPath>$(AcadDir)\ACA\AecPropDataMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccPressurePipesMgd">
      <HintPath>$(AcadDir)\C3D\AeccPressurePipesMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckAcadDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AcadDir)\acdbmgd.dll')"
           Text="Nao achei $(AcadDir)\acdbmgd.dll - o AutoCAD/Civil 3D $(Acad) esta instalado? (alvo escolhido por -p:Acad=2026|2027 ou pela configuracao Debug2027/Release2027)" />
    <Error Condition="Exists('$(AcadDir)\acdbmgd.dll') And !Exists('$(AcadDir)\C3D\AeccDbMgd.dll')"
           Text="$(AcadDir) existe, mas sem C3D\AeccDbMgd.dll: e o AutoCAD $(Acad) sem o Civil 3D (ou o Civil 3D $(Acad) esta em outra pasta). Instale o Civil 3D $(Acad) ou ajuste AcadDir no csproj." />
    <Error Condition="Exists('$(AcadDir)\acdbmgd.dll') And !Exists('$(AcadDir)\ACA\AecBaseMgd.dll')"
           Text="$(AcadDir) existe, mas sem ACA\AecBaseMgd.dll (componente AEC do Civil 3D $(Acad))." />
  </Target>

  <!--
    LISPs distribuidas dentro da DLL (modulo LispTools).
    Basta copiar .lsp/.vlx/.fas para Modules\LispTools\Lisp e recompilar.
    .info = cabecalho ;;@ avulso para arquivos compilados (VLX/FAS).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Modules\LispTools\Lisp\*.lsp;Modules\LispTools\Lisp\*.vlx;Modules\LispTools\Lisp\*.fas;Modules\LispTools\Lisp\*.info"
                      LogicalName="Lisp\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Blocos de suporte do SinC (Coluna Simples/Dupla/Tripla, Bracos, Porticos) para o modulo Viario > Placas. -->
  <ItemGroup>
    <EmbeddedResource Include="Modules\Viario\Resources\sinC_suportes.dxf.gz" LogicalName="Viario\sinC_suportes.dxf.gz" />
  </ItemGroup>

  <Target Name="ShowNetloadPath" AfterTargets="Build">
    <Message Importance="high" Text="============================================================" />
    <Message Importance="high" Text="DLL pronta para NETLOAD (Civil 3D $(Acad), $(TargetFramework)): $(TargetPath)" />
    <Message Importance="high" Text="============================================================" />
  </Target>

  <!--
    Copia a DLL Release para o Google Drive (acesso de qualquer computador): atual\ e versoes\<versao>\.
    So roda se a pasta existir (notebook e CAMELO com o Drive sincronizado); a versao vem de PluginVersions.cs.
  -->
  <PropertyGroup>
    <DriveDir Condition="'$(DriveDir)' == ''">G:\Meu Drive\Civil3D2026Plugin</DriveDir>
  </PropertyGroup>
  <Target Name="CopyToDrive" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(DriveDir)')">
    <PropertyGroup>
      <PluginVer>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Infrastructure\PluginVersions.cs')), '(?&lt;=Plugin = ")[^"]+').Value)</PluginVer>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DriveDir)\atual" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DriveDir)\versoes\$(PluginVer)" ContinueOnError="true" />
    <Message Importance="high" Text="DLL $(PluginVer) copiada para $(DriveDir)\atual" />
  </Target>

  <!--
    Copia tambem para a pasta "dll" da FDX no Drive (2 - Arquivos de Engenharia\dll). O caminho muda entre
    os PCs (Meu Drive ou atalho em G:\.shortcut-targets-by-id): tools\Copy-DllFdx.ps1 acha sozinho e so avisa
    se nao encontrar.
  -->
  <Target Name="CopyToFdx" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('G:\')">
    <PropertyGroup>
      <FdxVer>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Infrastructure\PluginVersions.cs')), '(?&lt;=Plugin = ")[^"]+').Value)</FdxVer>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Copy-DllFdx.ps1&quot; -Dll &quot;$(TargetPath)&quot; -Version $(FdxVer)" ContinueOnError="true" />
  </Target>

  <!--
    Copia local com a versao no nome (C:\Temp\hydro-build\Civil3D2026Plugin-2.86.2.dll): nunca esta presa
    pelo Civil aberto, entao cada compilacao ja fica pronta para o proximo NETLOAD (pegue a de versao maior).
  -->
  <PropertyGroup>
    <LocalBuildDir Condition="'$(LocalBuildDir)' == ''">C:\Temp\hydro-build</LocalBuildDir>
  </PropertyGroup>
  <Target Name="CopyVersionedLocal" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(LocalBuildDir)')">
    <PropertyGroup>
      <LocalVer>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Infrastructure\PluginVersions.cs')), '(?&lt;=Plugin = ")[^"]+').Value)</LocalVer>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(LocalBuildDir)\Civil3D2026Plugin-$(LocalVer).dll" ContinueOnError="true" />
    <!-- Fica so a mais nova; as antigas saem (a que estiver carregada no Civil fica, por estar presa). -->
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem '$(LocalBuildDir)' -Filter 'Civil3D2026Plugin-*.dll' | Sort-Object LastWriteTime -Descending | Select-Object -Skip 1 | Remove-Item -ErrorAction SilentlyContinue&quot;" ContinueOnError="true" />
    <Message Importance="high" Text="DLL $(LocalVer) em $(LocalBuildDir)\Civil3D2026Plugin-$(LocalVer).dll" />
  </Target>

</Project>
